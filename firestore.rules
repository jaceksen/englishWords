rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Each user can only read and write their own data.
    match /users/{uid}/{collection}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // The plan and Stripe ids are written only by Cloud Functions after a payment.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['plan', 'planUpdatedAt', 'stripe']);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'planUpdatedAt', 'stripe']);
    }
  }
}
