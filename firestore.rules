rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Each user can only read and write their own data.
    match /users/{uid}/{collection}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // Free plans given by the admin in the Firebase console (ID = e-mail in lowercase, as in MotoTigo).
    // Each user may read only their own grant; nobody writes from the app.
    match /freeplans/{email} {
      allow read: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // The plan, Stripe ids and the Google Play plan (store) are written only by Cloud Functions after a payment.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['plan', 'planUpdatedAt', 'stripe', 'store']);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'planUpdatedAt', 'stripe', 'store']);
    }
  }
}
