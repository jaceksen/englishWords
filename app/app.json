{
  "expo": {
    "name": "English Words",
    "slug": "english-words",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "englishwords",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Aplikacja rozpoznaje mowę, aby zapisywać słówka i sprawdzać odpowiedzi.",
        "NSMicrophoneUsageDescription": "Aplikacja używa mikrofonu do dyktowania słówek i odpowiedzi."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCF9ED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jacek.englishwords",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF9ED",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Aplikacja używa mikrofonu do dyktowania słówek i odpowiedzi.",
          "speechRecognitionPermission": "Aplikacja rozpoznaje mowę, aby zapisywać słówka i sprawdzać odpowiedzi.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          },
          "android": {
            "kotlinVersion": "2.4.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "19655ee6-3c23-43bf-ae02-1a0434654104"
      }
    },
    "owner": "jsen2",
    "platforms": [
      "android"
    ]
  }
}
